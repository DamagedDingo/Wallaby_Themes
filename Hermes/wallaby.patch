diff --git a/apps/desktop/src/themes/wallaby.test.ts b/apps/desktop/src/themes/wallaby.test.ts
new file mode 100644
index 0000000000..0bc4d20bed
--- /dev/null
+++ b/apps/desktop/src/themes/wallaby.test.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest'
+
+import { BUILTIN_THEMES } from './presets'
+import { listAllThemes, resolveTheme } from './user-themes'
+
+describe('Wallaby', () => {
+  it('uses the existing skin CSS hook to defeat inherited glass only while selected', () => {
+    const css = BUILTIN_THEMES.wallaby.customCSS ?? ''
+    expect(css).toContain('backdrop-filter: none !important')
+    expect(css).toContain('-webkit-backdrop-filter: none !important')
+    expect(css).toContain('--composer-fill: var(--theme-card-seed) !important')
+    expect(css).toContain('--ui-text-tertiary: #f2f2f2 !important')
+    expect(css).toContain('--ui-text-secondary: #f2f2f2 !important')
+    expect(css).toContain('--dt-popover: var(--theme-elevated-seed) !important')
+    expect(css).toContain('[data-slot="dialog-overlay"]')
+    expect(css).toContain('@layer base')
+    expect(css).toContain(':root[data-hermes-clear] [data-overlay-surface]')
+    expect(BUILTIN_THEMES.wallaby.opaque).toBe(true)
+    expect(css).not.toMatch(/blur\(|rgba\(|transparent/)
+    expect(BUILTIN_THEMES.nous.customCSS).toBeUndefined()
+  })
+  it('is registered through the standard built-in theme registry with the upstream palette', () => {
+    const theme = BUILTIN_THEMES.wallaby
+    expect(theme).toBeDefined()
+    expect(resolveTheme('wallaby')).toBe(theme)
+    expect(listAllThemes().filter(entry => entry.name === 'wallaby')).toEqual([theme])
+    expect(theme.label).toBe('Wallaby')
+    expect(theme.colors).toMatchObject({
+      background: '#1a5d6c',
+      foreground: '#f2f2f2',
+      card: '#2a6c7a',
+      popover: '#347483',
+      primary: '#ffbc03',
+      primaryForeground: '#1a5d6c'
+    })
+
+    for (const color of Object.values(theme.colors)) {
+      expect(color).toMatch(/^#[\da-f]{6}$/i)
+    }
+  })
+})
